# ==============================================================================
# Project Zomboid Dedicated Server + Web UI Environment Configuration
# ==============================================================================

# Timezone (e.g., UTC, America/New_York, Europe/London, Asia/Tokyo)
TZ=America/New_York

# Process User and Group ID (match your host user UID/GID to avoid permission issues)
PUID=1000
PGID=1000

# Server Identity
SERVER_NAME=server
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisSecretPassword123!
LANGUAGE=en

# Web UI Management Dashboard (Change this 1 line to change port)
WEBUI_PORT=5011
WEBUI_PASSWORD=ChangeThisSecretPassword123!
WEBUI_AUTH_DISABLED=false

# Game Version & Branch
# Options:
#   stable    - Latest Stable Server (Build 42 / Public)
#   42        - Build 42
#   unstable  - Bleeding Edge Unstable Branch
#   41        - Legacy Stable Build 41
#   42.19     - Legacy Unstable 42.19 Build
BUILD=stable

# Java Virtual Machine RAM allocation (e.g., 4096m, 8g, 16g)
MAX_RAM=8g

# Steam Authentication:
# Set to 'true' for standard Steam server
# Set to 'false' to allow non-Steam players (disables Steam authentication)
STEAM=true

# Supervisor behavior
AUTO_START=true

# Experimental JRE updater (updates default JRE to Zulu 17 for B41 or 25 for B42)
UPDATE_JRE=false

# Mod auto-downloader for non-steam servers
DISABLE_MOD_DOWNLOADER=false

# Download caching (/cache volume)
DISABLE_CACHE=false
